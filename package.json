{
  "name": "silicon-atlas",
  "version": "0.9.0",
  "description": "Interactive, model-backed labs for introductory solid-state and electronic/photonic devices courses",
  "license": "MIT",
  "author": "Sean Kim",
  "homepage": "https://sean-ksh.github.io/silicon-atlas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sean-KSH/silicon-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/Sean-KSH/silicon-atlas/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate": "node scripts/validation-report.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
